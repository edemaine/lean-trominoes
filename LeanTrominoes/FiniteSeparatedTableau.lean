import LeanTrominoes.FiniteNPCompilerRequest
import LeanTrominoes.FiniteAbsoluteProgram

/-! # Separating the endpoint and repeated constraints of a finite tableau

This equivalent expression groups initialization, acceptance, well-formedness,
and padded transitions into the four blocks generated by native emitters.
-/
noncomputable section
namespace LeanTrominoes.FiniteMachineTrace
open Turing PeriodicCNF PeriodicCNF.BoundedMachineAtom FiniteCNF
attribute [local instance] FinTM2.kFin FinTM2.ΛFin FinTM2.σFin
variable (tm : FinTM2) (space : Nat) [stackFinite : ∀ stack, Fintype (tm.Γ stack)]

def separatedExpression (test : TransitionExpr) (final : tm.Cfg) (steps : Nat) : TransitionExpr :=
  .and (absoluteExpression 0 test.atCurrent)
    (.and (absoluteExpression steps (currentConfigIs (space := space) (clockBits := 0) final).atCurrent)
      (.and (tableauExpression (fun _ => wellFormedFields (tm := tm) (space := space) (clockBits := 0)) (steps+1))
        (tableauExpression (fun _ => paddedStep tm space final) steps)))

private theorem split_predicates (steps : Nat) (wf initial final transition : Nat → Prop) :
    (∀ time < steps+1, wf time ∧ (time=0 → initial time) ∧
      (time=steps → final time) ∧ (time≠steps → transition time)) ↔
      initial 0 ∧ final steps ∧ (∀ time < steps+1, wf time) ∧ (∀ time < steps, transition time) := by
  constructor
  · intro h
    refine ⟨(h 0 (by omega)).2.1 rfl,(h steps (by omega)).2.2.1 rfl,
      fun time ht => (h time ht).1,?_⟩
    intro time ht
    exact (h time (by omega)).2.2.2 (by omega)
  · rintro ⟨initialTruth,finalTruth,wfTruth,transitionTruth⟩ time ht
    refine ⟨wfTruth time ht,?_,?_,?_⟩
    · rintro rfl; exact initialTruth
    · rintro rfl; exact finalTruth
    · intro different; exact transitionTruth time (by omega)

theorem separatedExpression_eval (test : TransitionExpr) (final : tm.Cfg) (steps : Nat)
    (assignment : Nat → Bool) :
    (separatedExpression tm space test final steps).eval assignment assignment=true ↔
      (tableauExpression (symbolicExpression tm space test final steps) (steps+1)).eval assignment assignment=true := by
  let trace := fun time atom => assignment (Nat.pair time atom)
  let wf := fun time => (wellFormedFields (tm := tm) (space := space) (clockBits := 0)).eval
    (trace time) (trace (time+1))=true
  let initial := fun time => test.eval (trace time) (trace time)=true
  let finish := fun time => (currentConfigIs (space := space) (clockBits := 0) final).eval (trace time) (trace time)=true
  let transition := fun time => (paddedStep tm space final).eval (trace time) (trace (time+1))=true
  have each (time : Nat) :
      (symbolicExpression tm space test final steps time).eval (trace time) (trace (time+1))=true ↔
        wf time ∧ (time=0 → initial time) ∧ (time=steps → finish time) ∧ (time≠steps → transition time) := by
    by_cases first : time=0 <;> by_cases last : time=steps <;>
      simp_all [symbolicExpression,TransitionExpr.eval,TransitionExpr.atCurrent_eval,
        wf,initial,finish,transition,first,last]
  have old : (tableauExpression (symbolicExpression tm space test final steps) (steps+1)).eval assignment assignment=true ↔
      ∀ time < steps+1, wf time ∧ (time=0 → initial time) ∧
        (time=steps → finish time) ∧ (time≠steps → transition time) := by
    rw [tableauExpression_eval]
    exact forall_congr' (fun time => forall_congr' (fun _ => each time))
  rw [old,split_predicates]
  simp [separatedExpression,TransitionExpr.eval,absoluteExpression_eval,tableauExpression_eval,
    TransitionExpr.atCurrent_eval,wf,initial,finish,transition,trace]

theorem separatedExpression_atomsBelow (test : TransitionExpr) (final : tm.Cfg) (steps : Nat)
    (bound : test.AtomsBelow (atomCount (tm := tm) (space := space) (clockBits := 0))) :
    (separatedExpression tm space test final steps).AtomsBelow
      ((steps+1+atomCount (tm := tm) (space := space) (clockBits := 0)+1)^2) := by
  refine ⟨absoluteExpression_atomsBelow 0 _ _ (steps+1) (TransitionExpr.atCurrent_atomsBelow bound) (by omega),
    absoluteExpression_atomsBelow steps _ _ (steps+1)
      (TransitionExpr.atCurrent_atomsBelow (currentConfigIs_atomsBelow final)) (by omega),
    tableauExpression_atomsBelow _ _ _ (fun _ _ => wellFormedFields_atomsBelow),?_⟩
  have h := tableauExpression_atomsBelow (fun _ => paddedStep tm space final)
    (atomCount (tm := tm) (space := space) (clockBits := 0)) steps
    (fun _ _ => paddedStep_atomsBelow tm space final)
  exact h.mono (Nat.pow_le_pow_left (by omega) 2)

theorem separatedExpression_atCurrent (test : TransitionExpr) (final : tm.Cfg) (steps : Nat) :
    (separatedExpression tm space test final steps).atCurrent=separatedExpression tm space test final steps := by
  simp [separatedExpression,TransitionExpr.atCurrent,absoluteExpression_atCurrent,tableauExpression_atCurrent]

end LeanTrominoes.FiniteMachineTrace
