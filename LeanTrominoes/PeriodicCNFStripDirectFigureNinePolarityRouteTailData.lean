import LeanTrominoes.PeriodicCNFProgramSource
import LeanTrominoes.PeriodicCNFFormulaShapeRetainedFigureNineSourceTailData
import LeanTrominoes.PeriodicCNFStripDirectSourceFormulaData

/-! # Direct retained Figure 9 header/tail records -/

noncomputable section

namespace LeanTrominoes
namespace PeriodicCNFStripReduction

variable {Input : Type}
variable {encoding : _root_.LeanTrominoes.FiniteEncoding Input}
variable {language : Input → Prop}
variable (decider : PeriodicCNF.ProgramSource encoding language)


local instance directFigureNinePolarityTailDataVariableDecidableEq :
    DecidableEq Variable :=
  directSourceVariableDecidableEq

/-- Specialize the exact retained header/tail records to the guarded PSPACE
source generated by a direct symbol stream. -/
def directFigureNinePolarityRouteTailRecords
    (symbols : List encoding.Γ) :
    List HorizontalRoutedRouteHeaderTail.Token :=
  PeriodicCNF.FormulaShapeRetainedFigureNineSourceTail.records
    (directSourceFormula decider symbols)

end PeriodicCNFStripReduction
end LeanTrominoes

end
