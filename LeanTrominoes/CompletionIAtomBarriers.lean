  have eq : (Atom.fixedList .clause).toFinset = Atom.fixed .clause := CompletionCellOrder.toFinset_eq _ _
  exact eq.symm.trans h.symm
theorem clause_holes_eq : (Atom.pattern .clause).region \ Atom.fixed .clause = clauseHoles.toFinset :=
  Atom.holes_of_merge .clause clauseHoles clause_fixed_eq (by decide +kernel)
theorem clause_available_core : Atom.available .clause ⊆ Atom.core .clause := by
  change ∀ c ∈ Atom.available .clause, c ∈ Atom.core .clause
  simp only [Atom.core,clause_holes_eq,Finset.mem_sdiff,List.mem_toFinset]
  decide +kernel

def clauseFringe : Finset Cell := ⟨(↑([(5,1),(5,2),(5,25),(5,26),(14,1),(14,2),(14,25),(14,26),(23,1),(23,2),(23,25),(23,26),(32,1),(32,2),(32,25),(32,26)] : List Cell) : Multiset Cell),by exact CompletionCellOrder.nodup _ (by decide +kernel)⟩
def clauseWitnesses : Finset Cell := ⟨(↑([(4,2),(4,25),(5,4),(5,23),(6,2),(6,25),(13,2),(13,25),(14,4),(14,23),(15,2),(15,25),(22,2),(22,25),(23,4),(23,23),(24,2),(24,25),(31,2),(31,25),(32,4),(32,23),(33,2),(33,25)] : List Cell) : Multiset Cell),by exact CompletionCellOrder.nodup _ (by decide +kernel)⟩
theorem clause_witnesses_fixed : clauseWitnesses ⊆ Atom.fixed .clause := by decide +kernel
theorem clause_fringe_checked : CompletionBarrier.GuardedCheck .I clauseFringe
    (Atom.pattern .clause).region clauseWitnesses (Atom.available .clause) := by
  unfold CompletionBarrier.GuardedCheck
  simp only [Finset.subset_iff,Atom.mem_region]
  decide +kernel
theorem clause_fringe_cover : ∀ c ∈ Atom.core .clause, (Atom.Interior .clause c) ∨ c ∈ clauseFringe := by
  simp only [Atom.core,clause_holes_eq,Finset.mem_sdiff,List.mem_toFinset,and_imp]
  decide +kernel
theorem clause_guarded : CompletionBarrier.GuardedCheck .I (Atom.core .clause)
    (Atom.pattern .clause).region (Atom.fixed .clause) (Atom.available .clause) := by
  apply Atom.guarded_of_fringe .clause clauseFringe clause_fringe_cover
  exact CompletionBarrier.guarded_mono_blocked _ _ _ _ _ _ clause_witnesses_fixed clause_fringe_checked

theorem Atom.fixed_eq (a : Atom) : a.fixed = a.pattern.fixedRegion := by
  cases a
  · exact equal_fixed_eq
  · exact negate_fixed_eq
  · exact plugTop_fixed_eq
  · exact plugBottom_fixed_eq
  · exact copy_fixed_eq
  · exact clause_fixed_eq

theorem Atom.available_core (a : Atom) : a.available ⊆ a.core := by
  cases a
  · exact equal_available_core
  · exact negate_available_core
  · exact plugTop_available_core
  · exact plugBottom_available_core
  · exact copy_available_core
  · exact clause_available_core

/-- Centered crossing tiles strand an interior wire cell; all other crossings hit a prefill. -/
theorem Atom.guarded (a : Atom) :
    CompletionBarrier.GuardedCheck .I a.core a.pattern.region a.fixed a.available := by
  cases a
  · exact equal_guarded
  · exact negate_guarded
  · exact plugTop_guarded
  · exact plugBottom_guarded
  · exact copy_guarded
  · exact clause_guarded

end LeanTrominoes.CompletionPattern.IBricks
