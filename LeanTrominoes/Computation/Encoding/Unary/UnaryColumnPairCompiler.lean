import LeanTrominoes.Computation.Encoding.Unary.UnaryColumnDivisionCompiler
import Mathlib.Data.Nat.Pairing

/-! # Polynomial-time squares, products, and absolute variable names

All magnitudes are supplied in unary. Squares are generated by prefix sums of
odd numbers; lookup and column arithmetic then implement multiplication and
Lean's natural pairing function with actual polynomial-time TM2 machines.
-/
noncomputable section
namespace LeanTrominoes.UnaryColumn
open Computability Turing
open UnaryFieldEncoderMachine (unaryFields)
variable {Symbol Index : Type} [Fintype Symbol] [Inhabited Symbol]
  {rows : List Symbol → List Index} {f g : List Symbol → Index → Nat}

private theorem startsAux_odds (offset count : Nat) :
    PrefixSums.startsAux (offset*offset)
      ((List.range count).map fun i => (offset+i)*2+1) =
      (List.range count).map (fun i => (offset+i)*(offset+i)) := by
  induction count generalizing offset with
  | zero => rfl
  | succ count ih =>
    rw [List.range_succ_eq_map]
    simp only [List.map_cons,List.map_map,Function.comp_def,Nat.add_zero,
      PrefixSums.startsAux_cons]
    have start : offset*offset+(offset*2+1)=(offset+1)*(offset+1) := by ring
    rw [start]
    have shift : (fun i : Nat => (offset+(i+1))*2+1)=
        (fun i => (offset+1+i)*2+1) := by funext i; congr 1 <;> omega
    rw [shift,ih]
    congr 1
    apply List.map_congr_left
    intro i _
    congr 1 <;> omega

theorem starts_odds (count : Nat) :
    PrefixSums.starts ((List.range count).map fun i => i*2+1)=
      (List.range count).map (fun i => i*i) := by
  simpa [PrefixSums.starts] using startsAux_odds 0 count

/-- The computed unary bound makes the square table polynomial in the input. -/
def square (queries : Compiler rows f) : Compiler rows (fun s i => f s i*f s i) := by
  let bound := columnBound queries
  let keys := naturalRange bound
  let odds := add (scale keys 2) (constant keys 1)
  let raw := TM2CompositionMachine.computableInPolyTime odds
    UnaryPrefixSumsMachine.computableInPolyTime
  let squares : Compiler (fun s => List.range (((rows s).map (f s)).sum+1))
      (fun _ i => i*i) := TM2ComputableInPolyTime.of_eq raw (fun s => starts_odds _)
  apply keyed queries keys squares (fun _ n => n*n)
  · intro s i _; rfl
  · intro s i hi
    refine ⟨f s i,List.mem_range.mpr ?_,rfl⟩
    have le := List.le_sum_of_mem (List.mem_map.mpr ⟨i,hi,rfl⟩ :
      f s i ∈ (rows s).map (f s))
    omega

theorem product_from_squares (a b : Nat) :
    ((a+b)*(a+b)-a*a-b*b)/2=a*b := by
  have eq : (a+b)*(a+b)=a*a+b*b+(a*b)*2 := by ring
  rw [eq]
  have sub : a*a+b*b+a*b*2-a*a-b*b=a*b*2 := by omega
  rw [sub,Nat.mul_div_left _ (by decide : 0 < 2)]

/-- Pointwise products preserve row order, including empty and repeated rows. -/
def multiply (first : Compiler rows f) (second : Compiler rows g) :
    Compiler rows (fun s i => f s i*g s i) := by
  let physical := halve (sub (sub (square (add first second)) (square first)) (square second))
  exact TM2ComputableInPolyTime.of_eq physical
    (fun s => List.map_congr_left (fun i _ => product_from_squares _ _))

theorem pair_from_arithmetic (a b : Nat) :
    (a+(b-a))*(a+(b-a))+a+b*(1-(b-a))=Nat.pair a b := by
  by_cases h : a < b
  · have excess : 1 ≤ b-a := by omega
    have mx : a+(b-a)=b := by omega
    simp [Nat.pair,h,mx,Nat.sub_eq_zero_of_le excess]
  · have excess : b-a=0 := by omega
    simp [Nat.pair,h,excess,Nat.add_assoc]

/-- Exact natural pairing for the time/source identifiers in finite tableaux. -/
def pair (first : Compiler rows f) (second : Compiler rows g) :
    Compiler rows (fun s i => Nat.pair (f s i) (g s i)) := by
  let excess := sub second first
  let maximum := add first excess
  let physical := add (add (square maximum) first)
    (multiply second (sub (constant first 1) excess))
  exact TM2ComputableInPolyTime.of_eq physical
    (fun s => List.map_congr_left (fun i _ => pair_from_arithmetic _ _))

end LeanTrominoes.UnaryColumn
