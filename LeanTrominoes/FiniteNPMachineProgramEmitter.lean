import LeanTrominoes.FiniteNPCompilerPreparation
import LeanTrominoes.PeriodicCNFMachineStepEmitter
import LeanTrominoes.PeriodicCNFMachineFixedConfigurationEmitterSpec
import LeanTrominoes.PeriodicCNFMachineProgramStatementPaths
import LeanTrominoes.TM2NativeListAppendClosure

/-! # Native program emitters for bounded NP verifier machines

The existing machine emitters are instantiated on the finite verifier's
prepared source word. Well-formedness, ordinary steps, and both accepting
configuration tests are generated by real polynomial-time TM2 machines.
-/
noncomputable section
namespace LeanTrominoes.FiniteNPMachineProgramEmitter
open Computability Turing PeriodicCNF
open AffineEmitterPipeline UnaryProgramTokens
open Complexity.VerifierInPolyTime FiniteNPCompilerPreparation
attribute [local instance] FinTM2.kFin FinTM2.ΛFin FinTM2.σFin
variable {Input : Type} {encoding : _root_.LeanTrominoes.FiniteEncoding Input} {language : Input → Prop}
variable (verifier : Complexity.VerifierInPolyTime encoding language)
noncomputable local instance (stack : verifier.computer.tm.K) :
    Fintype (verifier.computer.tm.Γ stack) := verifier.computer.stackAlphabetFinite stack

abbrev Source := Symbol encoding.Γ

def sourceSpace (symbols : List encoding.Γ) : Nat := (spacePolynomial verifier).eval symbols.length

theorem sourceSpace_positive (symbols : List encoding.Γ) : 0 < sourceSpace verifier symbols := by
  simp only [sourceSpace,spacePolynomial,Polynomial.eval_add,Polynomial.eval_X,
    Polynomial.eval_one,Polynomial.eval_mul,Polynomial.eval_C]
  omega

theorem spaceCount_prepared (symbols : List encoding.Γ) :
    UnaryPolynomialPaddingMachine.selectedCount (isCounter 2) (prepared verifier symbols)=
      sourceSpace verifier symbols := by
  exact counterCount_prepared verifier symbols 2

def wellFormedPhases : List (Phase (SelectedPrefixMarkerMachine.Tagged 1
    (Source (encoding := encoding)))) :=
  BoundedMachineWellFormedEmitter.phases (tm := verifier.computer.tm) (isCounter 2)

def wellFormedTokens (symbols : List encoding.Γ) : List Token :=
  emittedAll (wellFormedPhases verifier)
    (SelectedPrefixMarkerMachine.mark (isCounter 2) 1 (prepared verifier symbols))

theorem wellFormedTokens_eq (symbols : List encoding.Γ) : wellFormedTokens verifier symbols=
    ofProgram (BoundedMachineProgram.wellFormedFields (tm := verifier.computer.tm)
      (space := sourceSpace verifier symbols)) := by
  exact BoundedMachineWellFormedEmitter.emittedAll_phases (isCounter 2) (by decide)
    (prepared verifier symbols) _ (sourceSpace_positive verifier symbols) (spaceCount_prepared verifier symbols)

def wellFormedComputableInPolyTime : TM2ComputableInPolyTime id id (wellFormedTokens verifier) := by
  unfold wellFormedTokens
  let marked := TM2CompositionMachine.computableInPolyTime
    (FiniteNPCompilerPreparation.computableInPolyTime verifier)
    (SelectedPrefixMarkerMachine.computableInPolyTime (isCounter 2) 1)
  exact TM2CompositionMachine.computableInPolyTime marked
    (emittedAllComputableInPolyTime (wellFormedPhases verifier))

def stepTokens (symbols : List encoding.Γ) : List Token :=
  extractTokens (BoundedMachineStepEmitter.run (tm := verifier.computer.tm) (isCounter 2)
    (embedData (prepared verifier symbols)))

theorem stepTokens_eq (symbols : List encoding.Γ) : stepTokens verifier symbols=
    ofProgram (BoundedMachineProgram.machineStep (tm := verifier.computer.tm)
      (space := sourceSpace verifier symbols)) := by
  unfold stepTokens
  rw [BoundedMachineStepEmitter.run_eq_append]
  rw [selectedCount_embedData,spaceCount_prepared,
    BoundedMachineStepEmitter.emitted_eq_machineStep]
  simp [extractTokens,embedData,List.flatMap_map,Function.comp_def,← List.map_eq_flatMap]

def stepComputableInPolyTime : TM2ComputableInPolyTime id id (stepTokens verifier) := by
  unfold stepTokens
  let embedded := TM2CompositionMachine.computableInPolyTime
    (FiniteNPCompilerPreparation.computableInPolyTime verifier)
    (embedDataComputableInPolyTime (Data := Source (encoding := encoding)))
  let printed := TM2CompositionMachine.computableInPolyTime embedded
    (BoundedMachineStepEmitter.computableInPolyTime (tm := verifier.computer.tm) (isCounter 2))
  exact TM2CompositionMachine.computableInPolyTime printed
    (extractTokensComputableInPolyTime (Data := Source (encoding := encoding)))

def acceptingCutoff : Nat := (acceptingWord verifier).length

theorem acceptingFitsCutoff (stack : verifier.computer.tm.K) :
    ((acceptingConfiguration verifier).stk stack).length ≤ acceptingCutoff verifier := by
  by_cases same : stack=verifier.computer.tm.k₁
  · subst stack; simp [acceptingConfiguration,acceptingCutoff,haltList]
  · simp [acceptingConfiguration,haltList,same]

theorem acceptingFitsSpace (symbols : List encoding.Γ) (stack : verifier.computer.tm.K) :
    ((acceptingConfiguration verifier).stk stack).length ≤ sourceSpace verifier symbols := by
  apply (acceptingFitsCutoff verifier stack).trans
  simp only [acceptingCutoff,sourceSpace,spacePolynomial,Polynomial.eval_add,
    Polynomial.eval_X,Polynomial.eval_one,Polynomial.eval_mul,Polynomial.eval_C]
  omega

def acceptingPhases (slice : TransitionSlice) : List (Phase (SelectedPrefixMarkerMachine.Tagged
    (acceptingCutoff verifier) (Source (encoding := encoding)))) :=
  BoundedMachineFixedConfigurationEmitter.phases (tm := verifier.computer.tm) (isCounter 2)
    slice (acceptingConfiguration verifier)

def acceptingTokens (slice : TransitionSlice) (symbols : List encoding.Γ) : List Token :=
  emittedAll (acceptingPhases verifier slice)
    (SelectedPrefixMarkerMachine.mark (isCounter 2) (acceptingCutoff verifier) (prepared verifier symbols))

theorem acceptingTokens_eq (slice : TransitionSlice) (symbols : List encoding.Γ) :
    acceptingTokens verifier slice symbols=ofProgram
      (BoundedMachineFixedConfigurationEmitter.configurationIs (tm := verifier.computer.tm)
        slice (acceptingConfiguration verifier) (sourceSpace verifier symbols)) := by
  exact BoundedMachineFixedConfigurationEmitter.emittedAll_phases (isCounter 2) slice
    (acceptingConfiguration verifier) (acceptingFitsCutoff verifier) (prepared verifier symbols)
    _ (acceptingFitsSpace verifier symbols) (spaceCount_prepared verifier symbols)

def acceptingComputableInPolyTime (slice : TransitionSlice) :
    TM2ComputableInPolyTime id id (acceptingTokens verifier slice) := by
  unfold acceptingTokens
  let marked := TM2CompositionMachine.computableInPolyTime
    (FiniteNPCompilerPreparation.computableInPolyTime verifier)
    (SelectedPrefixMarkerMachine.computableInPolyTime (isCounter 2) (acceptingCutoff verifier))
  exact TM2CompositionMachine.computableInPolyTime marked
    (emittedAllComputableInPolyTime (acceptingPhases verifier slice))

end LeanTrominoes.FiniteNPMachineProgramEmitter
