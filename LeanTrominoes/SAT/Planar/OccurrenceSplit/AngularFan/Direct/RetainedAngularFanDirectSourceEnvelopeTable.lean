import LeanTrominoes.SAT.Planar.OccurrenceSplit.AngularFan.Direct.RetainedAngularFanDirectSourcePrefixAtlas

/-! Numeric envelopes for the direct-source tail atlas. Their equality to the
envelope computations is certified in `RetainedAngularFanDirectSourceTailSeparation`.
Each entry stores the escape and tail upper/lower bounds for one occurrence slot.
Only the upper triangle is used; the separation proof handles reversed pairs. -/

namespace LeanTrominoes.PeriodicEightOccurrenceSplit

/-- Escape and tail linear envelopes, each in upper/lower bound order. -/
abbrev SourceRouteEnvelope := (Int × Int) × (Int × Int)

/-- Candidate-normal, first-slot, and second-slot envelope data for a literal pair. -/
abbrev SourcePairEnvelopes := List (List SourceRouteEnvelope × List SourceRouteEnvelope)

/-- The matrix of envelope data for all pairs of literal indices. -/
abbrev SourceEnvelopeTable := List (List SourcePairEnvelopes)

set_option maxRecDepth 10000
